# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local fixtures — run the whole app with no backend.
#
# Fixtures are generated from the committed seed SQL (`pnpm generate:fixtures`),
# so the 18 buildings, their zones and their typical-occupancy curves match what
# a real database holds. They report no live occupancy on purpose: that is the
# true state of a campus app with no users, and it is the state the UI most
# needs to handle well.
#
# Leave unset to auto-detect: fixtures are used whenever Supabase has no
# credentials, so a fresh clone runs with no setup. Set explicitly to override.
#   true  — always use fixtures, even with Supabase configured
#   false — always use Supabase, even without credentials (shows a config error)
# VITE_USE_FIXTURES=

# Mapbox (public token, safe in client)
VITE_MAPBOX_TOKEN=

# Google Places API — SERVER SIDE ONLY
# Do NOT add a VITE_ prefix — this key must never reach the client
# Set as a Supabase Edge Function secret via:
#   Supabase Dashboard > Project Settings > Edge Functions > Secrets
#   Name: GOOGLE_PLACES_API_KEY
# GOOGLE_PLACES_API_KEY=

# Web Push VAPID — public key needed on client for push subscription
VITE_VAPID_PUBLIC_KEY=

# Web Push VAPID — SERVER SIDE ONLY, used in Edge Functions
# Set as Supabase Edge Function secrets (not in this file)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=
